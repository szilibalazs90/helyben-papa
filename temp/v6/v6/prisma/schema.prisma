generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Role { CUSTOMER PARTNER SUPERADMIN }
enum PartnerKind { RESTAURANT BEAUTY GROOMING AUTO_TIRE AUTO_REPAIR OTHER }
enum OrderStatus { PENDING PREPARING READY OUT_FOR_DELIVERY COMPLETED CANCELLED }
enum ApptStatus { PENDING CONFIRMED COMPLETED CANCELLED }
enum Fulfilment { DELIVERY PICKUP }

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  phone String
  passwordHash String
  role Role @default(CUSTOMER)
  partnerId String?
  partner Partner? @relation(fields: [partnerId], references: [id])
  orders Order[]
  appointments Appointment[]
  createdAt DateTime @default(now())
}
model Category { id String @id @default(cuid())
  slug String @unique
  name String
  partners Partner[] }
model Partner {
  id String @id @default(cuid())
  slug String @unique
  name String
  kind PartnerKind
  city String
  address String
  phone String?
  lat Float?
  lng Float?
  openingHours Json
  photos String[]
  verified Boolean @default(false)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  menuItems MenuItem[]
  services Service[]
  orders Order[]
  appointments Appointment[]
  users User[]
  reviews Review[]
}
model MenuItem {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  soup String?
  main String
  description String?
  photoUrl String?
  priceHuf Int
  portionsLeft Int
  available Boolean @default(true)
  pickup Boolean @default(true)
  delivery Boolean @default(true)
  validOn DateTime
}
model Service {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  name String
  minutes Int
  priceHuf Int
  capacityPerSlot Int @default(1)
  appointments Appointment[]
}
model Order {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  status OrderStatus @default(PENDING)
  fulfilment Fulfilment
  address String?
  payment String
  totalHuf Int
  items Json
  createdAt DateTime @default(now())
  @@index([partnerId, createdAt])
}
model Appointment {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  startsAt DateTime
  status ApptStatus @default(PENDING)
  @@unique([partnerId, serviceId, startsAt])
}
model Review { id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  rating Int
  text String?
  createdAt DateTime @default(now()) }
